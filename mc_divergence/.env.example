# Copie ce fichier en ".env" (même dossier) et remplis les valeurs.
# ".env" est ignoré par git (voir .gitignore) -- ne jamais committer de vrai mot de passe.
# Ce fichier (.env.example), lui, est sûr à committer : aucune vraie valeur dedans.

# Serveur SMTP. Exemples :
#   Gmail      : smtp.gmail.com
#   Office365  : smtp.office365.com
#   Relais interne HPS : demander à l'infra
SMTP_HOST=smtp.gmail.com

# 587 = STARTTLS (standard), 465 = SSL. Laisser vide = 587 par défaut.
SMTP_PORT=587

# Ton adresse d'envoi (souvent identique à SMTP_FROM)
SMTP_USER=

# IMPORTANT : pas ton mot de passe de compte normal.
# Gmail  : myaccount.google.com > Sécurité > Validation en 2 étapes > Mots de passe des applications
# Office365 : portal.office.com > Sécurité > Mot de passe d'application
SMTP_PASSWORD=

# Optionnel : adresse affichée comme expéditeur si différente de SMTP_USER
SMTP_FROM=

# Destinataires des alertes, séparés par des virgules.
MC_DIVERGENCE_RECIPIENTS=
