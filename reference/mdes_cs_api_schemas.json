  "_meta": {
    "description": "Request/response schemas for the 6 MDES Customer Service APIs (Search -> Token Delete) as actually implemented in project pwc-api-sp5_api, extracted from source for comparison against the official Mastercard MDES Customer Service API reference.",
    "sourceOfTruth": "https://developer.mastercard.com/mdes-customer-service/documentation/api-reference/",
    "callSites": [
      "ws-core-impl/src/main/java/com/acp/vision/pcrd/ws/impl/v2/TokenInquiryRequestWebService.java",
